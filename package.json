{
  "name": "act-ts-repo",
  "description": "Anonymous Credit Tokens (ACT) implementation in TypeScript",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p packages/sigma-proofs && tsc -p packages/act-ts && tsc -p tsconfig.node.json",
    "lint": "biome check",
    "format": "biome check --write",
    "bench": "npm run bench --workspaces --if-present",
    "examples": "npm run examples --workspace act-ts"
  },
  "license": "Apache-2.0",
  "version": "0.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "tsdown": "0.23.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "packages/sigma-proofs",
    "packages/act-ts"
  ],
  "packageManager": "npm@11.3.0+sha512.96eb611483f49c55f7fa74df61b588de9e213f80a256728e6798ddc67176c7b07e4a1cfc7de8922422cbce02543714367037536955221fa451b0c4fefaf20c66",
  "overrides": {
    "tsdown": {
      "typescript": "7.0.2"
    }
  }
}
