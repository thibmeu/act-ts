{
  "name": "act-ts",
  "version": "0.1.0",
  "description": "Anonymous Credit Tokens (draft-schlesinger-mole-ec-act)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "examples": "node --conditions=development examples/index.ts"
  },
  "keywords": [
    "anonymous",
    "credit",
    "tokens",
    "cryptography",
    "privacy",
    "ietf"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/act-ts.git",
    "directory": "packages/act-ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "sigma-proofs": "0.1.0"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
